  primary: rgb("#252d34"),
  secondary: rgb("#2a7ba8"),
  accent: rgb("#2f9fdc"),
  ink: rgb("#1b1e21"),
  muted: rgb("#737d85"),
  rule: rgb("#d5dade"),
  surface: rgb("#eef4f8"),
  code-bg: rgb("#f6f8fa"),
  note: rgb("#2f9fdc"),
  warn: rgb("#cc8434"),
)

#let primary = palette.primary
#let secondary = palette.secondary
#let accent = palette.accent
